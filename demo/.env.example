# Copiaza acest fisier ca demo/.env si completeaza cu datele bazei tale Postgres.
# (demo/.env este citit automat de backend; nu il distribui, contine parola.)
#
# Format: postgresql+psycopg2://UTILIZATOR:PAROLA@HOST:PORT/NUMELE_BAZEI
DATABASE_URL=postgresql+psycopg2://postgres:PAROLA_TA@localhost:5432/licenta_demo
